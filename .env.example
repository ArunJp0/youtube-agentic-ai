GEMINI_API_KEY=
# Chosen via a real health check (python -m src.gemini_health_check) during
# the LLM/Gemini Reliability Audit milestone: gemini-3.6-flash (the prior
# fallback) was timing out under real load; both of these lite-tier models
# responded successfully. Re-run the health check periodically since Gemini
# free-tier model availability/quota can change.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# LLM Provider Configuration (mock | gemini)
LLM_PROVIDER=gemini

# SEARCH Provider Configuration (mock | wikipedia)
SEARCH_PROVIDER=wikipedia

# VOICE Provider Configuration (mock | edge)
VOICE_PROVIDER=edge
VOICE_NAME=en-US-AriaNeural

# MEDIA Provider Configuration (mock | pexels)
# Pexels requires a free API key: https://www.pexels.com/api/
MEDIA_PROVIDER=pexels
PEXELS_API_KEY=

# TRANSCRIPTION Provider Configuration (mock | whisper) - used by the
# standalone Caption Service. Whisper runs fully locally (no API key,
# no paid API) via faster-whisper; model weights download once and cache.
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL_SIZE=base

# Topic Planner mode (evergreen | trending | mixed) - "evergreen" (the
# default) only ever draws from a fixed, small candidate list unless
# TOPIC_PLANNER_SOURCE is also a real (non-"mock") source. "mixed" merges
# real evergreen (YouTube popular videos, needs YOUTUBE_API_KEY below - the
# component fails gracefully in isolation without one, so mixed mode still
# works with real current-news candidates alone) with real current/trending
# news (Google News RSS - no API key required). Requires
# TOPIC_NEWS_SOURCES_ENABLED=true for "trending"/"mixed" to use real news.
TOPIC_MODE=mixed
TOPIC_NEWS_SOURCES_ENABLED=true
# TOPIC_PLANNER_SOURCE Configuration (mock | youtube) - "mock" forces every
# topic source (evergreen AND news) to the offline in-memory double, even in
# trending/mixed mode; any non-mock value (only "youtube" is implemented
# today) is required to get real current-news candidates.
TOPIC_PLANNER_SOURCE=youtube


# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/youtube_ai

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# YouTube (not used in MVP)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Target script/video duration for the Script Agent's content/word budget
# (short ~3-5min | standard ~5-8min | long ~10-15min), or a direct minutes
# override. "standard" is the current next-demo target.
SCRIPT_DURATION_PROFILE=standard
SCRIPT_TARGET_DURATION_MINUTES=

# AI Video Generation (see src/tools/ai_video_provider.py) - disabled by
# default; when enabled, STOCK_FALLBACK_ENABLED keeps Pexels as a safety
# net so a visual slot is never left empty. AI_VIDEO_PROVIDER: "mock" (test
# double) | "local" (DEMO ONLY - serves pre-generated local clips from
# AI_VIDEO_LOCAL_CLIPS_DIR, e.g. manually produced via a free web tier like
# PixVerse Basic; never calls a real API). A real paid provider (fal.ai/
# Kling, Seedance, Veo, PixVerse's official API, ...) is added later purely
# by implementing AIVideoProvider - never a Visual Planner change.
AI_VIDEO_ENABLED=false
AI_VIDEO_PROVIDER=mock
AI_VIDEO_MODEL=
AI_VIDEO_LOCAL_CLIPS_DIR=
AI_VIDEO_MAX_CLIPS_PER_RUN=5
AI_VIDEO_MAX_RETRIES=2
AI_VIDEO_MAX_COST_USD=
STOCK_FALLBACK_ENABLED=true

# ElevenLabs (not used in MVP)
ELEVENLABS_API_KEY=

# External Search (not used in MVP)
SERPER_API_KEY=
BRAVE_API_KEY=

# Logging
LOG_LEVEL=INFO
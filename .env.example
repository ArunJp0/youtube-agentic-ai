GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# LLM Provider Configuration (mock | gemini)
LLM_PROVIDER=gemini

# SEARCH Provider Configuration (mock | wikipedia)
SEARCH_PROVIDER=wikipedia

# VOICE Provider Configuration (mock | edge)
VOICE_PROVIDER=edge
VOICE_NAME=en-US-AriaNeural

# MEDIA Provider Configuration (mock | pexels)
# Pexels requires a free API key: https://www.pexels.com/api/
MEDIA_PROVIDER=pexels
PEXELS_API_KEY=

# TRANSCRIPTION Provider Configuration (mock | whisper) - used by the
# standalone Caption Service. Whisper runs fully locally (no API key,
# no paid API) via faster-whisper; model weights download once and cache.
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL_SIZE=base


# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/youtube_ai

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# YouTube (not used in MVP)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ElevenLabs (not used in MVP)
ELEVENLABS_API_KEY=

# External Search (not used in MVP)
SERPER_API_KEY=
BRAVE_API_KEY=

# Logging
LOG_LEVEL=INFO